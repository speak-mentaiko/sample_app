<%= form_with(model: @micropost) do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="mb-3">
    <%= f.text_area :content, class: "form-control", placeholder: "Compose new micropost..." %>
  </div>

  <%= f.submit "Post", class: "btn btn-primary w-100" %>

  <span class="image">
    <%= f.file_field :image, accept: "image/jpeg, image/gif, image/png image/webp" %>
  </span>
<% end %>
